# used by `watchpost check --alert` to notify on down/recovery
# works with either a Slack incoming webhook or a Discord webhook url
WATCHPOST_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# used by `watchpost check --diagnose` to explain failures in plain English
# costs a small amount per call - opt-in only, never used unless you pass the flag
ANTHROPIC_API_KEY=sk-ant-your-key-here
